      "dompurify@>=3.0.0 <=3.4.7": ">=3.4.8",
      "dompurify@<=3.4.6": ">=3.4.7",
      "multer@>=1.0.0 <2.2.0": ">=2.2.0",
      "multer@>=2.0.0-alpha.1 <2.2.0": ">=2.2.0",
      "undici@>=7.23.0 <7.28.0": ">=7.28.0",
      "dompurify@<=3.4.10": ">=3.4.11",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "better-auth@<1.6.13": ">=1.6.13",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
