# ── WorkOS Auth (required) ──────────────────────────────────────────────────
# Get these from dash.workos.com → your app → API Keys
WORKOS_API_KEY=sk_live_...
WORKOS_CLIENT_ID=client_...
# Must match a Redirect URI registered in WorkOS dashboard
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3500/auth/callback
# 32+ char random secret: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=change_me_generate_a_32_char_secret_here

# ── Stripe Billing (optional — billing routes return 503 if unset) ──────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID_CLOUD=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudflare (required for tenant KV registry) ─────────────────────────────
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
CF_KV_TENANT_REGISTRY_ID=...

# ── Backend service URLs ─────────────────────────────────────────────────────
# For local dev, these default to localhost in the code
# For production, point these at your deployed services
NEXT_PUBLIC_PAPERCLIP_URL=https://paperclip.yourdomain.com
NEXT_PUBLIC_OPENFANG_URL=https://openfang.yourdomain.com
NEXT_PUBLIC_OPENCLAW_URL=https://openclaw.yourdomain.com
NEXT_PUBLIC_HERMES_URL=https://hermes.yourdomain.com

# Internal URLs (server-side only, not exposed to browser)
OPENCLAW_INTERNAL_URL=http://localhost:4000
OPENFANG_INTERNAL_URL=http://localhost:4001
HERMES_INTERNAL_URL=http://localhost:4002
PAPERCLIP_INTERNAL_URL=http://localhost:4003
CLAWHIP_INTERNAL_URL=http://localhost:4004

# Gateway auth token (shared secret between dashboard and agent services)
OPENCLAW_GATEWAY_TOKEN=change_me_random_secret

# ── Slack Integration (optional) ─────────────────────────────────────────────
SLACK_SIGNING_SECRET=...
SLACK_BOT_TOKEN=xoxb-...

# ── AI Keys (optional — required for AI features) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── License / Feature Flags ──────────────────────────────────────────────────
# Values: cloud | self_hosted | enterprise
CLAWHQ_LICENSE_TIER=cloud

# Bridge secret (internal service-to-service auth)
CLAWHQ_BRIDGE_SECRET=change_me_random_secret

# ── Pack Registry (required for premium packs) ───────────────────────────────
PACK_REGISTRY_URL=https://packs.clawhqplatform.com

# ── Optional: Analytics (Plausible) ─────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=clawhq.yourdomain.com
